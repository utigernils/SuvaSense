# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# PostgreSQL
DATABASE_URL=postgres://suvasense:suvasense_secret@localhost:5432/suvasense?sslmode=disable
DB_SCHEMA_PATH=./schema.sql

# MQTT
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=suvasense-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=suva/+/data
MQTT_QOS=1
MQTT_CONNECT_TIMEOUT_SEC=10
MQTT_RECONNECT_INTERVAL_SEC=5

# API status threshold
SENSOR_ONLINE_THRESHOLD_SEC=30
